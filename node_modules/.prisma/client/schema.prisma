generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  NURSE
  STAFF
}

enum ItemCategory {
  MEDICAMENTO
  CURATIVO
}

enum MovementType {
  ENTRADA
  SAIDA
}

model User {
  id          String       @id @default(uuid())
  name        String
  email       String       @unique
  pictureUrl  String?
  role        Role         @default(STAFF)
  createdAt   DateTime     @default(now())
  Attendances Attendance[]
}

model Class {
  id          String       @id @default(uuid())
  name        String
  stage       String?
  createdAt   DateTime     @default(now())
  Attendances Attendance[]
}

model Reason {
  id          String       @id @default(uuid())
  name        String       @unique
  active      Boolean      @default(true)
  Attendances Attendance[]
}

model Communication {
  id          String       @id @default(uuid())
  name        String       @unique
  Attendances Attendance[]
}

model Attendance {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now())
  nome        String
  vinculo     String?
  funcao      String?
  descricao   String?
  responsavel String?
  destino     String?
  horaChegada DateTime?
  hgt         Float?
  temperatura Float?
  fc          Int?
  pa          String?
  spo2        Int?

  classId       String?
  motivoId      String?
  comunicacaoId String?
  userId        String?

  class       Class?         @relation(fields: [classId], references: [id])
  motivo      Reason?        @relation(fields: [motivoId], references: [id])
  comunicacao Communication? @relation(fields: [comunicacaoId], references: [id])
  user        User?          @relation(fields: [userId], references: [id])

  medications AttendanceMedication[]
  movements   Movement[]
}

model Item {
  id           String       @id @default(uuid())
  nome         String
  categoria    ItemCategory
  unidade      String
  minimo       Int          @default(0)
  estoqueAtual Int          @default(0)

  // ✅ NOVO: define se o item baixa estoque automaticamente em atendimentos
  descontaEstoque Boolean @default(true)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  movements            Movement[]
  AttendanceMedication AttendanceMedication[]

  @@index([nome])
}

model Movement {
  id         String       @id @default(uuid())
  tipo       MovementType
  quantidade Int
  motivo     String?
  createdAt  DateTime     @default(now())

  itemId       String
  attendanceId String?

  item       Item        @relation(fields: [itemId], references: [id])
  attendance Attendance? @relation(fields: [attendanceId], references: [id])

  // ✅ NOVO: aparece no histórico, mas só entra no saldo quando true
  contabilizaEstoque Boolean @default(true)

  @@index([createdAt])
}

model AttendanceMedication {
  id           String @id @default(uuid())
  attendanceId String
  itemId       String
  quantidade   Int

  attendance Attendance @relation(fields: [attendanceId], references: [id])
  item       Item       @relation(fields: [itemId], references: [id])

  @@unique([attendanceId, itemId])
}
